---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
---

<Layout
  title="404: Page Not Found — BCAway"
  description="The page you requested could not be found."
>
  <main class="page-container">
    <div class="content-wrapper">
      <div class="brand-section">
        <div class="logo-wrapper">
          <Logo width={72} />
        </div>
        <span class="error-badge">404</span>
        <h1 class="error-title">Page not found</h1>
        <p class="error-description">
          The link you followed may be broken, or the page may have been moved.
        </p>
      </div>

      <div class="actions-container">
        <a href="/" class="primary-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Back to Home
        </a>

        <a href="https://app.bcaway.app" class="secondary-btn" target="_blank" rel="noopener noreferrer">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
          Launch Web App
        </a>
      </div>

      <footer class="page-footer">
        <div class="footer-links">
          <a href="/privacy" class="footer-link">Privacy Policy</a>
          <span class="footer-sep">•</span>
          <a href="/terms" class="footer-link">Terms & Disclaimers</a>
          <span class="footer-sep">•</span>
          <a href="mailto:kabsek30@bergen.org" class="footer-link">Contact</a>
        </div>
        <p class="copyright-text">
          &copy; {new Date().getFullYear()} Kabir Sekhon. All rights reserved.
        </p>
      </footer>
    </div>
  </main>
</Layout>

<style>
  .page-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 20px 40px;
    width: 100%;
  }

  .content-wrapper {
    max-width: 440px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .brand-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 32px;
  }

  .logo-wrapper {
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .error-badge {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-primary);
    background-color: var(--color-primary-light);
    border: 1px solid #BFDBFE;
    padding: 3px 10px;
    border-radius: var(--radius-full);
    margin-bottom: 12px;
  }

  .error-title {
    font-size: 32px;
    font-weight: 800;
    color: var(--color-text-main);
    letter-spacing: -0.025em;
    margin-bottom: 10px;
  }

  .error-description {
    font-size: 15px;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .actions-container {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    margin-bottom: 48px;
  }

  .primary-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: var(--color-primary);
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 600;
    padding: 14px 20px;
    border-radius: var(--radius-md);
    transition: background-color 0.15s ease, transform 0.15s ease;
    box-shadow: 0 1px 3px rgba(37, 99, 235, 0.25);
  }

  .primary-btn:hover {
    background-color: var(--color-primary-hover);
    transform: translateY(-1px);
  }

  .primary-btn:active {
    transform: translateY(0);
  }

  .secondary-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-text-main);
    font-size: 15px;
    font-weight: 600;
    padding: 13px 20px;
    border-radius: var(--radius-md);
    transition: all 0.15s ease;
  }

  .secondary-btn:hover {
    background-color: var(--color-surface);
    border-color: #D1D5DB;
    transform: translateY(-1px);
  }

  .secondary-btn:active {
    transform: translateY(0);
  }

  .page-footer {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    border-top: 1px solid var(--color-border);
    padding-top: 24px;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .footer-link:hover {
    color: var(--color-primary);
  }

  .footer-sep {
    color: var(--color-border);
    font-size: 11px;
  }

  .copyright-text {
    font-size: 11.5px;
    color: var(--color-text-tertiary);
  }
</style>
