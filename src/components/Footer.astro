---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class:list={['page-footer', className]}>
  <div class="footer-links">
    <a href="/requestteacher" class="footer-link">Request a Teacher</a>
    <span class="footer-sep">•</span>
    <a href="/contact" class="footer-link">Contact</a>
    <span class="footer-sep">•</span>
    <a href="https://instagram.com/getbcaway" target="_blank" rel="noopener noreferrer" class="footer-link">Instagram</a>
    <span class="footer-sep">•</span>
    <a href="https://github.com/bcaway" target="_blank" rel="noopener noreferrer" class="footer-link">GitHub</a>
    <span class="footer-sep">•</span>
    <a href="/privacy" class="footer-link">Privacy</a>
    <span class="footer-sep">•</span>
    <a href="/terms" class="footer-link">Terms</a>
  </div>

  <p class="copyright-text">
    &copy; {currentYear} Kabir Sekhon. Licensed under AGPL v3.0.
  </p>
</footer>

<style>
  .page-footer {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    border-top: 1px solid var(--color-border);
    padding-top: 28px;
    margin-top: 40px;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .footer-link {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-link:hover {
    color: var(--color-primary);
  }

  .footer-sep {
    color: var(--color-border);
    font-size: 11px;
    user-select: none;
  }

  .copyright-text {
    font-size: 12px;
    color: var(--color-text-tertiary);
    text-align: center;
    line-height: 1.4;
  }
</style>
