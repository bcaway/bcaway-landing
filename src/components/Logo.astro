---
interface Props {
  width?: number | string;
  color?: string;
  class?: string;
}

const {
  width = 96,
  color = "#2563EB",
  class: className = "",
} = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 818 348"
  width={width}
  height="auto"
  fill="none"
  class={className}
  aria-label="BCAway Logo"
>
  <!-- Bottom rod -->
  <rect x="0" y="229" width="409" height="119" rx="59.5" fill={color} />
  <!-- Middle rod -->
  <rect x="90" y="106" width="409" height="119" rx="59.5" fill={color} />
  <!-- Tilted rod -->
  <g transform="translate(629.5, 125.3) rotate(27)">
    <rect x="-204.5" y="-59.5" width="409" height="119" rx="59.5" fill={color} />
  </g>
</svg>
